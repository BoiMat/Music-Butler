# Fresh ./scripts/setup.sh generates .env with your IDs. If copying, edit IDs yourself.
LOCAL_UID=1000
LOCAL_GID=1000
# A second instance on the same machine needs its own project name, image tag and port
# (see README "Good to know"), e.g. COMPOSE_PROJECT_NAME=music-butler-anna.
# COMPOSE_PROJECT_NAME=
TOOLS_IMAGE=music-butler-tools:local
# 0.64 minor alias was NOT published; verified release tag instead. See BLUEPRINT.
NAVIDROME_IMAGE=deluan/navidrome:0.64.1
BIND_ADDRESS=127.0.0.1
NAVIDROME_PORT=4533
MUSIC_LIBRARY_PATH=./storage/library
NAVIDROME_DATA_PATH=./storage/navidrome
SECRETS_PATH=./secrets
SCAN_SCHEDULE=@every 1m
DOWNLOAD_ALLOWED_HOSTS=archive.org,upload.wikimedia.org,www.youtube.com,youtube.com,youtu.be,m.youtube.com,music.youtube.com
# Sent to non-YouTube archives instead of a fake browser UA. Wikimedia requires contact info,
# e.g. "music-butler/0.1.0 (you@example.com)"; without it upload.wikimedia.org returns 403.
DOWNLOAD_USER_AGENT=
# Set a real project URL or contact email per LRCLIB policy. Empty disables lookups.
LRCLIB_USER_AGENT=
# Optional admin scan. Blank user means schedule-only; no secret required at startup.
NAVIDROME_USER=
NAVIDROME_PASSWORD_FILE=/run/music-secrets/navidrome_password
# The account you play and rate with (e.g. Tempo's playback account). Discovery reads
# its stars, ratings and plays. Put its password in secrets/navidrome_listener_password
# (chmod 600). Blank = use the admin account above.
NAVIDROME_LISTENER_USER=
NAVIDROME_LISTENER_PASSWORD_FILE=/run/music-secrets/navidrome_listener_password
# restic repository for scripts/backup.sh, e.g. /Volumes/MyDrive/music-butler-restic
# (macOS) or /media/you/MyDrive/music-butler-restic (Linux). The encryption password
# lives in the macOS Keychain or a RESTIC_PASSWORD_FILE (see README), never in this file.
BACKUP_REPOSITORY=
# Navidrome fetches artist pictures from Deezer by artist name. false = fully offline.
DEEZER_ENABLED=true
# Scheduled runs (scripts/scheduled.sh audit|bootstrap|weekly; see README "Scheduled runs").
# SCHEDULE_AGENT: hermes, or command (any agent CLI that reads the task on stdin).
SCHEDULE_AGENT=
# command: split on spaces, no shell quoting.
# e.g. claude -p --allowedTools Bash(scripts/butler.sh:*),Bash(./scripts/butler.sh:*),Read,Edit(requests/**)
SCHEDULE_COMMAND=
# hermes: blank provider/model = the profile's defaults; weekly discovery can use a stronger model.
HERMES_PROFILE=music-butler
SCHEDULE_PROVIDER=
SCHEDULE_MODEL=
SCHEDULE_MODEL_WEEKLY=
# The daily bootstrap stops once the library holds this many songs and the playlist queue is empty.
BOOTSTRAP_TARGET=150
# Whole-playlist imports (butler.sh playlist <id>): the command that receives a report
# every 20 songs on stdin (split on spaces), e.g. hermes -p music-butler send --to telegram --quiet.
# Blank = reports only in requests/spotify-<id>.log.
PLAYLIST_NOTIFY=
# Folder to pick playlist CSVs up from (butler.sh inbox), e.g. the Hermes profile's
# cache/documents, where files sent to the bot on Telegram are saved.
PLAYLIST_INBOX=
