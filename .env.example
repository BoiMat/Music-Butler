# Fresh ./scripts/setup.sh generates .env with your IDs. If copying, edit IDs yourself.
LOCAL_UID=1000
LOCAL_GID=1000
# 0.64 minor alias was NOT published; verified release tag instead. See BLUEPRINT.
NAVIDROME_IMAGE=deluan/navidrome:0.64.1
BIND_ADDRESS=127.0.0.1
NAVIDROME_PORT=4533
LIBRARY_PATH=./storage/library
NAVIDROME_DATA_PATH=./storage/navidrome
SECRETS_PATH=./secrets
SCAN_SCHEDULE=@every 1m
DOWNLOAD_ALLOWED_HOSTS=archive.org,upload.wikimedia.org,www.youtube.com,youtube.com,youtu.be
# Requires operator-created secrets/spotify.json (0600) with official API client_id/client_secret.
ENABLE_SPOTDL=false
# Set a real project URL or contact email per LRCLIB policy. Empty disables lookups.
LRCLIB_USER_AGENT=
# Optional admin scan. Blank user means schedule-only; no secret required at startup.
NAVIDROME_USER=
NAVIDROME_PASSWORD_FILE=/run/music-secrets/navidrome_password
